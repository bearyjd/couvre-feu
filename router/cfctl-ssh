#!/bin/sh
# Dropbear forced-command boundary: tokens only, no shell syntax or eval.
set -f
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LC_ALL=C
export LC_ALL
cf_rpc_only=0
case $# in
    0);;
    1)[ "$1" = --rpc-only ] || exit 2;cf_rpc_only=1;;
    *)exit 2;;
esac
cf_ssh_command=${SSH_ORIGINAL_COMMAND-}
cf_ssh_target=/usr/sbin/cfctl
# The grammar fixture may invoke only a marked private-root executable.
if [ "${CF_TEST_MODE-}" = 1 ];then
    case ${CF_ROOT-} in /tmp/couvre-feu-*) ;; *) exit 2;; esac
    case ${CF_BACKEND_DIR-} in "$CF_ROOT"/*) ;; *) exit 2;; esac
    [ -d "$CF_ROOT" ] && [ ! -L "$CF_ROOT" ] && [ -d "$CF_BACKEND_DIR" ] && [ ! -L "$CF_BACKEND_DIR" ] && [ -f "$CF_BACKEND_DIR/.couvrefeu-test-backend" ] && [ ! -L "$CF_BACKEND_DIR/.couvrefeu-test-backend" ] || exit 2
    [ "$(CDPATH='' cd -- "$CF_ROOT" && pwd -P)" = "$CF_ROOT" ] && [ "$(CDPATH='' cd -- "$CF_BACKEND_DIR" && pwd -P)" = "$CF_BACKEND_DIR" ] || exit 2
    cf_ssh_target=$CF_BACKEND_DIR/cfctl
    [ -f "$cf_ssh_target" ] && [ ! -L "$cf_ssh_target" ] && [ -x "$cf_ssh_target" ] || exit 2
fi
unset ENV BASH_ENV CDPATH IFS
# ASCII space is the only permitted separator; no quoting/options interpolation.
case $cf_ssh_command in ''|*[!a-z0-9_\ -]*) exit 2;; esac
[ "${#cf_ssh_command}" -le 160 ] || exit 2
IFS=' '
 # shellcheck disable=SC2086
set -- $cf_ssh_command
[ "$#" -ge 2 ] && [ "$1" = cfctl ] || exit 2
shift
if [ "$cf_rpc_only" = 1 ];then
    case $1 in rpc-sync|rpc-status|rpc-activity);;*)exit 2;;esac
fi
case $1 in
    rpc-sync) [ "$#" = 1 ] || exit 2;;
    rpc-status)
        [ "$#" = 2 ] || [ "$#" = 3 ] || exit 2
        [ "$2" = --json ] || exit 2
        if [ "$#" = 3 ];then
            case $3 in ''|[!a-z0-9]*|*[!a-z0-9_-]*)exit 2;;esac
            [ "${#3}" -le 64 ] || exit 2
        fi;;
    status|activity|rpc-activity) [ "$#" = 2 ] && [ "$2" = --json ] || exit 2;;
    sync|expire|apply-fw) [ "$#" = 1 ] || exit 2;;
    pause)
        if [ "$#" = 2 ];then :;elif [ "$#" = 4 ] && [ "$3" = --until ];then
            printf '%s\n' "$4" | awk '$0!~/^(0|[1-9][0-9]*)$/||length($0)>10||$0+0>2147483647{exit 1}' || exit 2
        else exit 2;fi
        case $2 in ''|*[!a-z0-9_]*|[!a-z]*) exit 2;; esac
        [ "${#2}" -le 32 ] || exit 2;;
    resume)
        [ "$#" = 2 ] || exit 2
        case $2 in ''|*[!a-z0-9_]*|[!a-z]*) exit 2;; esac
        [ "${#2}" -le 32 ] || exit 2;;
    *) exit 2;;
esac
exec env -i PATH="$PATH" LC_ALL=C SSH_CONNECTION="${SSH_CONNECTION-}" SSH_CLIENT="${SSH_CLIENT-}" "$cf_ssh_target" "$@"
