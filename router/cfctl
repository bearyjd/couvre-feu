#!/bin/sh
# shellcheck disable=SC1090,SC1091,SC2034
# Dynamic installed helpers share variables with this entry point.
# Couvre-feu router entry point. POSIX ash; never run live from a test root.
set -f
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LC_ALL=C
export LC_ALL
umask 077
CF_CALLBACK_GENERATION=
if [ "${1:-}" = --installation-generation ]; then
    if [ "$#" != 3 ] || [ -n "${CF_SERVICE_FORCED_COMMAND+x}" ]; then exit 2; fi
    case "$2" in *[!0-9a-f]*|'') exit 2;; esac
    [ "${#2}" = 64 ] || exit 2
    case "$3" in expire|apply-fw) ;; *) exit 2;; esac
    CF_CALLBACK_GENERATION=$2
    shift 2
fi
CF_LOCAL_TEST=0
if [ "${CF_TEST_MODE-}" = 1 ]; then
    case ${CF_ROOT-} in /tmp/couvre-feu-*) ;; *) printf '%s\n' '{"ok":false,"errors":["unsafe_test_root"]}'; exit 2;; esac
    case ${CF_BACKEND_DIR-} in "$CF_ROOT"/*) ;; *) printf '%s\n' '{"ok":false,"errors":["unsafe_test_backend"]}'; exit 2;; esac
    if [ ! -d "$CF_ROOT" ] || [ -L "$CF_ROOT" ] || [ ! -d "$CF_BACKEND_DIR" ] || [ -L "$CF_BACKEND_DIR" ] || [ ! -f "$CF_BACKEND_DIR/.couvrefeu-test-backend" ] || [ -L "$CF_BACKEND_DIR/.couvrefeu-test-backend" ]; then
        printf '%s\n' '{"ok":false,"errors":["unsafe_test_backend"]}'; exit 2
    fi
    if [ "$(CDPATH='' cd -- "$CF_ROOT" && pwd -P)" != "$CF_ROOT" ] || [ "$(CDPATH='' cd -- "$CF_BACKEND_DIR" && pwd -P)" != "$CF_BACKEND_DIR" ];then
        printf '%s\n' '{"ok":false,"errors":["unsafe_test_backend"]}';exit 2
    fi
    CF_LOCAL_TEST=1
    CF_BASE=$CF_ROOT
    if [ "$0" = "$CF_ROOT/usr/sbin/cfctl" ];then
        CF_LIB=$CF_ROOT/usr/lib/couvrefeu
        [ -d "$CF_LIB" ] && [ ! -L "$CF_LIB" ] && [ "$(CDPATH='' cd -- "$CF_LIB" && pwd -P)" = "$CF_LIB" ] || exit 2
    else
        CF_LIB=$(CDPATH='' cd -- "$(dirname -- "$0")/lib" && pwd -P) || exit 2
    fi
else
    if [ -n "${CF_ROOT-}" ] || [ -n "${CF_BACKEND_DIR-}" ]; then
        printf '%s\n' '{"ok":false,"errors":["test_environment_requires_test_mode"]}'; exit 2
    fi
    CF_BASE=
    CF_LIB=/usr/lib/couvrefeu
    if [ "${1:-}" = recover-install-lock ] || [ -n "$CF_CALLBACK_GENERATION" ]; then
        CF_LIB=$(CDPATH='' cd -- "$(dirname -- "$0")/lib" && pwd -P) || exit 2
    fi
    if [ "$(id -u)" != 0 ]; then printf '%s\n' '{"ok":false,"errors":["root_required"]}'; exit 2; fi
fi
if [ "$CF_LOCAL_TEST" = 1 ] && [ -n "${CF_TEST_AWK-}" ]; then
    case $CF_TEST_AWK in
        'busybox awk')CF_BUSYBOX=$(command -v busybox) || exit 2;;
        /tmp/*/busybox\ awk)CF_BUSYBOX=${CF_TEST_AWK% awk};[ -f "$CF_BUSYBOX" ] && [ ! -L "$CF_BUSYBOX" ] && [ -x "$CF_BUSYBOX" ] || exit 2;;
        *)exit 2;;
    esac
    awk() { "$CF_BUSYBOX" awk "$@"; }
fi
# Scope administration (M1d): the typed confirmation is read HERE, before platform admission, so
# no platform or policy lock and no admission deadline is held while a human types. core.sh
# repeats every check under cf_lock and refuses scope-add/scope-remove unless this step ran.
# Exit status matches core.sh for the same refusal: 2 for invalid_command, 1 for every other one.
cf_scope_confirmed=0
case ${1-} in scope-preview|scope-add|scope-remove)
    # PATH and LC_ALL are already pinned at the top of this file; re-pinned here so the block stands alone.
    PATH=/usr/sbin:/usr/bin:/sbin:/bin;LC_ALL=C;export PATH LC_ALL
    # A stopped or flow-controlled terminal must never hold a lock: job-control stops are ignored from
    # here to exit, XON/XOFF is switched off on an output TTY, and core.sh prints only after unlocking.
    trap '' TSTP TTIN TTOU
    [ ! -t 1 ] || stty -ixon <&1 2>/dev/null || :
    cf_scope_early() { printf '{"ok":false,"errors":["%s"]}\n' "$1"; [ "$1" != invalid_command ] || exit 2; exit 1; }
    [ -z "${CF_SERVICE_FORCED_COMMAND+x}" ] || cf_scope_early scope_forced_command_refused
    if [ "$1" != scope-preview ]; then
        # Argv shape is checked again in cfctl-scope and cf_scope_main: defence in depth, do not simplify.
        if ! { [ "$#" = 4 ] && [ "$3" = --base ]; }; then cf_scope_early invalid_command; fi
        case $2 in [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) ;; *) cf_scope_early scope_mac_not_canonical;; esac
        case $4 in *[!0-9a-f]*) cf_scope_early scope_base_invalid;; esac
        [ "${#4}" = 64 ] || cf_scope_early scope_base_invalid
        [ -t 0 ] || cf_scope_early scope_tty_required
        printf '%s %s --base %s\nType the last 6 hex digits of the address (no colons) to confirm: ' "$1" "$2" "$4"
        IFS= read -r cf_scope_answer || cf_scope_answer=
        # Last three octets of the validated canonical MAC, without colons (no external command).
        cf_scope_rest=${2#??:??:??:}
        cf_scope_tail=${cf_scope_rest%%:*}
        cf_scope_rest=${cf_scope_rest#??:}
        cf_scope_tail=$cf_scope_tail${cf_scope_rest%:*}${cf_scope_rest#*:}
        printf '\n'
        [ "$cf_scope_answer" = "$cf_scope_tail" ] || cf_scope_early scope_confirmation_mismatch
        cf_scope_confirmed=1
    fi;;
esac
# BEGIN authenticated bootstrap boundary
cf_bootstrap_refuse() { printf '%s\n' '{"ok":false,"errors":["platform_admission_refused"]}'; exit 2; }
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL
umask 077
if [ -n "${LD_PRELOAD-}${LD_LIBRARY_PATH-}${LD_AUDIT-}" ] || [ "${CF_TRANSACTION_DEFINITIONS_ONLY+x}${CF_TRANSACTION_LAUNCH_PID+x}${CF_TRANSACTION_PID+x}${CF_TRANSACTION_START+x}${CF_TRANSACTION_BOOT+x}${CF_TRANSACTION_RETIREMENT+x}${CF_TRANSACTION_RECOVER+x}${CF_TRANSACTION_FENCE+x}${CF_TRANSACTION_PREPARED+x}${CF_TRANSACTION_BASE+x}${CF_TRANSACTION_HELD+x}${CF_TRANSACTION_OWNED+x}${CF_TRANSACTION_TOKEN+x}${CF_TRANSACTION_PARENT+x}${CF_TRANSACTION_MUTEX+x}${CF_TRANSACTION_OWNER+x}${CF_TRANSACTION_DIGEST+x}${CF_TRANSACTION_STATE+x}${CF_PLATFORM_ADMITTED+x}${CF_PLATFORM_LOCKED+x}${CF_PLATFORM_NESTED+x}${CF_RELEASE_ID+x}${CF_PLATFORM_PROFILE+x}${CF_PLATFORM_CALLER_PID+x}${CF_PLATFORM_OWNER+x}${CF_PLATFORM_LIB+x}${CF_VENDOR_PROFILE+x}${CF_OS_TRUST_PROFILE+x}${CF_PLATFORM_ENTRY_TICK+x}${CF_PLATFORM_INITIAL_WRITE+x}${CF_RELEASE_MODULES+x}${vp_profile+x}" != "" ]; then
    printf '%s\n' 'couvre-feu: injected platform environment refused' >&2
    cf_bootstrap_refuse
fi
unset CF_PLATFORM_ADMITTED CF_PLATFORM_LOCKED CF_PLATFORM_NESTED CF_RELEASE_ID CF_PLATFORM_PROFILE CF_VENDOR_PROFILE CF_OS_TRUST_PROFILE CF_PLATFORM_ENTRY_TICK CF_PLATFORM_INITIAL_WRITE CF_RELEASE_MODULES CF_PLATFORM_CALLER_PID CF_PLATFORM_OWNER CF_PLATFORM_LIB vp_profile
# Capture once before bootstrap; invalid clocks refuse only the OS-trust profile.
cf_capture_entry_tick() {
    IFS=' ' read -r cf_entry_uptime cf_entry_unused < /proc/uptime || return 2
    cf_entry_seconds=${cf_entry_uptime%.*}; cf_entry_fraction=${cf_entry_uptime#*.}
    case "$cf_entry_seconds:$cf_entry_fraction" in *[!0-9:]*|:*) return 2;; esac
    [ "${#cf_entry_seconds}" -le 10 ] && [ "${#cf_entry_fraction}" = 2 ] || return 2
    case "$cf_entry_seconds" in 0|[1-9]*) ;; *) return 2;; esac
    cf_entry_fraction=${cf_entry_fraction#0}; cf_entry_fraction=${cf_entry_fraction:-0}
    printf '%s\n' "$((cf_entry_seconds * 100 + cf_entry_fraction))"
}
CF_PLATFORM_ENTRY_TICK=$(cf_capture_entry_tick) || CF_PLATFORM_ENTRY_TICK=
CF_BOOTSTRAP_PIN=b7c1c01fb7a731e0abe415fee17332fc2bf812e522824e595cac8d8ba6815a9a
platform_bootstrap_path=$CF_LIB/platform-bootstrap.sh
if ! { [ -f "$platform_bootstrap_path" ] && [ ! -L "$platform_bootstrap_path" ] && [ "$(CDPATH='' cd -- "${platform_bootstrap_path%/*}" && pwd -P)" = "${platform_bootstrap_path%/*}" ]; }; then cf_bootstrap_refuse; fi
platform_bootstrap_digest=$(timeout -s KILL 6 sha256sum "$platform_bootstrap_path") || cf_bootstrap_refuse
[ "${platform_bootstrap_digest%% *}" = "$CF_BOOTSTRAP_PIN" ] || cf_bootstrap_refuse
# shellcheck disable=SC1091
. "$platform_bootstrap_path"
platform_deadline_check
# END authenticated bootstrap boundary
# Sync stage state is internal; any inherited value, even empty, is refused.
if [ "${CF_SYNC_STAGED+x}${CF_SYNC_STAGE_MODE+x}${CF_SYNC_STAGE_TRIED+x}${CF_INPUT_DIR+x}${CF_STAGED_POLICY+x}${CF_NEXT_DIGEST+x}${CF_REQUEST_GENERATION+x}${CF_REQUEST_ID+x}${CF_BASE_REVISION+x}${CF_BASE_DIGEST+x}${CF_RPC_REQUIRE_RUNTIME+x}" != "" ]; then
    printf '%s\n' 'couvre-feu: injected stage environment refused' >&2
    cf_bootstrap_refuse
fi
platform_entry_root_validate
if [ -n "$CF_CALLBACK_GENERATION" ]; then
    platform_verify_modules "$CF_LIB"
    [ "${CF_TEST_MODE:-0}" = 1 ] || platform_external_closure "${CF_LIB%/lib}"
fi
if [ "${1:-}" = recover-install-lock ]; then
    if ! { [ "$#" = 1 ] && [ -z "${CF_SERVICE_FORCED_COMMAND+x}" ]; }; then cf_bootstrap_refuse; fi
    platform_verify_modules "$CF_LIB"
    platform_recovery_release=${CF_LIB%/lib}
    [ "${CF_TEST_MODE:-0}" = 1 ] || platform_external_closure "$platform_recovery_release"
    platform_choose runtime "$CF_BASE"
    if [ "${CF_TEST_MODE:-0}" = 1 ]; then platform_recovery_owner=$CF_ROOT/.couvrefeu-transaction
    else platform_recovery_owner=/etc/.couvrefeu-transaction; fi
    if [ -e "$platform_recovery_owner" ] || [ -L "$platform_recovery_owner" ]; then
        platform_regular "$platform_recovery_owner"
        platform_private "$platform_recovery_owner" 600
        platform_recovery_profile=$(sed -n '8p' "$platform_recovery_owner")
        case "$platform_recovery_profile" in strict|gl-xe3000-4.8.3-logd-011-v1|gl-xe3000-4.8.3-os-trust-v1) ;;
            *) cf_bootstrap_refuse;; esac
        platform_choose "$platform_recovery_profile" "$CF_BASE"
    fi
    if platform_vendor_selected; then platform_bootstrap_vendor; platform_attest_vendor "$CF_LIB"; fi
    CF_PLATFORM_ADMITTED=1
    CF_PLATFORM_LIB=$CF_LIB
    platform_profile_validate
    platform_transaction_mutex
    CF_TRANSACTION_RECOVER=1
    set +f
    . "$CF_LIB/install-common.sh"
    recover_install_lock
    exit 0
fi
platform_choose runtime "$CF_BASE"
if platform_vendor_selected; then platform_bootstrap_vendor; fi
if [ "$CF_LOCAL_TEST" != 1 ];then platform_private "$CF_LIB" 700; platform_private "$CF_LIB/platform-bootstrap.sh" 644; platform_verify_modules "$CF_LIB";fi
. "$CF_LIB/core.sh"
platform_deadline_check
if [ "${1:-}" = apply-fw ] && cf_reentrant_include; then exit 0;fi
if [ "${1:-}" = recover-platform-lock ] && [ "$#" = 1 ]; then
    platform_vendor_selected || platform_fail vendor_recovery_only
    platform_attest_vendor "$CF_LIB"
    platform_profile_validate
    platform_transaction_gate recover-platform-lock
    platform_lock_recover
    printf '%s\n' '{"ok":true,"platformLockRecovered":true}'
    exit 0
fi
# Exact sync/rpc-sync: authenticate modules, then finish bounded input staging before
# platform admission and before ANY permanent or compatibility lock exists. Admission
# and every core/RPC lock-held check below run afresh after the wait.
if [ "$#" = 1 ] && { [ "$1" = sync ] || [ "$1" = rpc-sync ]; }; then
    platform_verify_modules "$CF_LIB"
    cf_stage_entry_mode=0
    [ "$1" = sync ] || cf_stage_entry_mode=1
    if ! cf_sync_stage "$cf_stage_entry_mode"; then
        if [ "$cf_stage_entry_mode" = 1 ]; then printf '{"rpc_version":1,"errors":["%s"]}\n' "${CF_ERROR:-invalid_command}"
        else cf_busy_result; fi
        exit 1
    fi
fi
platform_admit runtime "$CF_BASE" "$CF_LIB"
if [ -n "$CF_CALLBACK_GENERATION" ]; then
    platform_transaction_mutex
    if ! { [ -e "$CF_TRANSACTION_OWNER" ] && [ ! -L "$CF_TRANSACTION_OWNER" ]; }; then platform_fail stale_installation_callback; fi
    platform_transaction_read
    [ "$CF_TRANSACTION_STATE" = complete ] || platform_fail inactive_installation_callback
    cf_expected_generation=$(printf 'CFCALLBACK1\n%s\n' "$CF_TRANSACTION_TOKEN" | sha256sum | awk '{print $1}')
    [ "$CF_CALLBACK_GENERATION" = "$cf_expected_generation" ] || platform_fail stale_installation_callback
    platform_private "$CF_TRANSACTION_BASE/backup/complete" 600
    printf '1\n' | cmp -s - "$CF_TRANSACTION_BASE/backup/complete" || platform_fail incomplete_installation_callback
    platform_transaction_gate
fi
trap 'platform_lock_release; cf_output_release' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
. "$CF_LIB/rpc.sh"
. "$CF_LIB/firewall.sh"
. "$CF_LIB/activity.sh"
platform_deadline_check
# No lock may be held while output blocks: buffer stdout, release every lock, then write (core.sh).
CF_OUTPUT_WANTED=1
if [ "$CF_PLATFORM_LOCKED" = 1 ] || [ "${CF_TRANSACTION_HELD:-0}" = 1 ]; then cf_output_begin; fi
cf_main "$@"
cf_output_release
