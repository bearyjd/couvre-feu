{
  "name": "couvre-feu-local-demo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": { "node": "26.8.1", "npm": "11.19.0" },
  "scripts": {
    "demo:start": "node service/src/main.ts",
    "integration:start": "node service/src/integration-main.ts",
    "integration:bootstrap": "node service/src/integration-bootstrap.ts",
    "integration:dispatch": "node service/src/integration-dispatch.ts",
    "demo:router": "node demo-router/src/main.ts",
    "demo:bootstrap": "node service/src/bootstrap.ts",
    "demo:scenario": "node demo-router/src/scenario-cli.ts",
    "test:service": "node --test --test-isolation=none shared/tests/*.test.ts service/tests/*.test.ts",
    "test:web": "playwright test --config web/playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@simplewebauthn/server": "13.3.3" },
  "devDependencies": { "@levischuck/tiny-cbor": "0.2.11", "@playwright/test": "1.61.0", "@types/node": "26.6.5", "typescript": "7.0.2" }
}
