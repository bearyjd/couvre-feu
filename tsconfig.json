{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "erasableSyntaxOnly": true,
    "types": ["node"], "skipLibCheck": true
  },
  "include": ["shared/**/*.ts", "service/**/*.ts", "demo-router/**/*.ts", "web/**/*.ts"]
}
